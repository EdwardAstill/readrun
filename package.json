{
  "name": "readrun",
  "version": "0.1.0",
  "description": "Turn Markdown folders into interactive sites with runnable Python and React widgets.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "bin": {
    "rr": "src/cli.ts"
  },
  "files": [
    "src",
    "src-electron",
    "docs",
    "integrations",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --hot src/cli.ts serve docs --no-open",
    "build:docs": "bun src/cli.ts build docs",
    "check": "bun run typecheck && bun run test && bun run validate:docs",
    "test": "bun test ./src ./src-electron --parallel",
    "typecheck": "tsc --noEmit",
    "validate:docs": "bun src/cli.ts validate docs --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdwardAstill/readrun.git"
  },
  "bugs": {
    "url": "https://github.com/EdwardAstill/readrun/issues"
  },
  "homepage": "https://github.com/EdwardAstill/readrun#readme",
  "keywords": [
    "markdown",
    "documentation",
    "static-site-generator",
    "pyodide",
    "bun"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "happy-dom": "^20.11.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.3.0",
    "@xyflow/react": "^12.11.6",
    "bun-plugin-tailwind": "^0.1.2",
    "citty": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.1.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.27.0",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^4.12.2",
    "sci-calc-widget": "github:EdwardAstill/sci-calc-widget#v0.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  }
}
